@model LMSystem.ViewModels.ReturnViewModel
@{
    ViewData["Title"] = "Return Book";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" asp-controller="Books" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold mb-0 text-success">Return Book</h2>
                <p class="text-secondary mb-0">Confirm the return of this borrowed book.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0 border border-success border-opacity-25">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-25 rounded-circle mb-3 text-success" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-box-archive fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-1">@Model.BookTitle</h3>
                    <p class="text-secondary mb-0">Borrowed by @Model.BorrowerName</p>
                </div>

                <div class="bg-dark bg-opacity-50 p-4 rounded-3 mb-4 border border-color" style="border-color: var(--border-color);">
                    <div class="row g-3">
                        <div class="col-12 text-center">
                            <span class="text-secondary small d-block mb-1"><i class="fa-regular fa-clock me-1"></i> Borrowed On</span>
                            <span class="fw-medium text-white">@Model.BorrowDate?.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Return" method="post" class="d-flex gap-3">
                    <input type="hidden" asp-for="BorrowRecordId" />
                    <button type="submit" class="btn btn-success flex-grow-1 shadow-sm py-2 fw-semibold">
                        <i class="fa-solid fa-check me-2"></i> Confirm Return
                    </button>
                    <a asp-action="Index" asp-controller="Books" class="btn btn-outline-secondary py-2 px-4 fw-semibold">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
