@model List<LMSystem.Models.StudentModel>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Students List</h2>
        <p class="text-secondary mb-0">Manage registered students.</p>
    </div>
    <a href="/Student/Create" class="btn btn-primary shadow-sm"><i class="fa-solid fa-plus me-2"></i> Add New Student</a>
</div>

<div class="table-container shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" class="ps-3" style="width: 80px;">ID</th>
                    <th scope="col">Student Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col" class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 text-secondary font-monospace small">#@item.StudentId</td>
                        <td class="fw-medium text-white">
                            <div class="d-flex align-items-center">
                                <div class="bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-user text-secondary small"></i>
                                </div>
                                @item.StudentName
                            </div>
                        </td>
                        <td class="text-secondary"><a href="mailto:@item.Email" class="text-decoration-none" style="color: var(--accent-primary);">@item.Email</a></td>
                        <td class="text-secondary">@item.Phone</td>
                        <td class="text-end pe-3">
                            <div class="btn-group shadow-sm">
                                <a href="/Student/Edit/@item.StudentId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <a href="/Student/Delete/@item.StudentId" onclick="return confirm('Are you sure you want to delete this student?')" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
