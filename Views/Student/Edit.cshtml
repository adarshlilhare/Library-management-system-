@model LMSystem.Models.StudentModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold mb-0">Edit Student</h2>
                <p class="text-secondary mb-0">Update student information.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="StudentId" />
                    
                    <div class="mb-4">
                        <label class="form-label text-secondary fw-semibold">Student Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input asp-for="StudentName" class="form-control border-start-0 ps-0" />
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label text-secondary fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-envelope"></i>
                            </span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" />
                        </div>
                    </div>
                    
                    <div class="mb-5">
                        <label class="form-label text-secondary fw-semibold">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-phone"></i>
                            </span>
                            <input asp-for="Phone" class="form-control border-start-0 ps-0" />
                        </div>
                    </div>
                    
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm py-2 fw-semibold">
                            <i class="fa-solid fa-check me-2"></i> Update Student
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2 px-4 fw-semibold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
