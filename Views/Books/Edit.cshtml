@model LMSystem.Models.Book
@{
    ViewData["Title"] = "Edit Book";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold mb-0">Edit Book</h2>
                <p class="text-secondary mb-0">Update book details in the catalog.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="BookId" />
                    <input type="hidden" asp-for="IsAvailable" />
                    
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label text-secondary fw-semibold">Book Title</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-book"></i>
                            </span>
                            <input asp-for="Title" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Author" class="form-label text-secondary fw-semibold">Author</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-pen-nib"></i>
                            </span>
                            <input asp-for="Author" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="Author" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ISBN" class="form-label text-secondary fw-semibold">ISBN</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-solid fa-barcode"></i>
                            </span>
                            <input asp-for="ISBN" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="ISBN" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="PublishedDate" class="form-label text-secondary fw-semibold">Published Date</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                                <i class="fa-regular fa-calendar-days"></i>
                            </span>
                            <input asp-for="PublishedDate" type="date" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="PublishedDate" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm py-2 fw-semibold">
                            <i class="fa-solid fa-check me-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2 px-4 fw-semibold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
