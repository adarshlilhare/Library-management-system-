@model IEnumerable<LMSystem.Models.Book>
@inject LMSystem.Models.LibraryContext _context
@{
    ViewData["Title"] = "Books List";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-25 text-white" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Books List</h2>
        <p class="text-secondary mb-0">Manage and track library books.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="fa-solid fa-plus me-2"></i> Add New Book</a>
</div>

<div class="table-container shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" class="ps-3">Title</th>
                    <th scope="col">Author</th>
                    <th scope="col">ISBN</th>
                    <th scope="col">Published Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td class="ps-3 fw-medium text-white">@item.Title</td>
                    <td class="text-secondary">@item.Author</td>
                    <td class="text-secondary font-monospace small">@item.ISBN</td>
                    <td class="text-secondary">@item.PublishedDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (item.IsAvailable) {
                            <span class="badge rounded-pill bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle-check me-1 small"></i> Available</span>
                        } else {
                            <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 px-2 py-1"><i class="fa-solid fa-clock me-1 small"></i> Borrowed</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group shadow-sm">
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-info" title="Details"><i class="fa-solid fa-circle-info"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                        </div>
                        <div class="d-inline-block ms-2">
                            @if (item.IsAvailable) {
                                <a asp-action="Create" asp-controller="Borrow" asp-route-bookId="@item.BookId" class="btn btn-sm btn-primary shadow-sm"><i class="fa-solid fa-hand-holding-hand me-1"></i> Borrow</a>
                            } else {
                                <a asp-action="Return" asp-controller="Borrow" asp-route-borrowRecordId="@(_context.BorrowRecords13.FirstOrDefault(b => b.BookId == item.BookId && b.ReturnDate == null)?.BorrowRecordId ?? 0)" class="btn btn-sm btn-success shadow-sm"><i class="fa-solid fa-box-archive me-1"></i> Return</a>
                            }
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
