@model List<LMSystem.Models.LibrarianModel>
@{
    ViewData["Title"] = "Librarians";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Librarians List</h2>
        <p class="text-secondary mb-0">Manage library staff members.</p>
    </div>
    <a href="/Librarian/Create" class="btn btn-primary shadow-sm"><i class="fa-solid fa-plus me-2"></i> Add New Librarian</a>
</div>

<div class="table-container shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" class="ps-3" style="width: 80px;">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Phone</th>
                    <th scope="col" class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 text-secondary font-monospace small">#@item.LibrarianId</td>
                        <td class="fw-medium text-white">
                            <div class="d-flex align-items-center">
                                <div class="bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-user-tie text-secondary small"></i>
                                </div>
                                @item.Name
                            </div>
                        </td>
                        <td class="text-secondary">@item.Age yrs</td>
                        <td class="text-secondary"><i class="fa-solid fa-phone me-2 small opacity-50"></i>@item.Phone</td>
                        <td class="text-end pe-3">
                            <div class="btn-group shadow-sm">
                                <a href="/Librarian/Edit/@item.LibrarianId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <a href="/Librarian/Delete/@item.LibrarianId" onclick="return confirm('Are you sure you want to delete this librarian?')" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
