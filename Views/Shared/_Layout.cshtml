<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryManagement</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <i class="fa-solid fa-book-open text-primary"></i>
                    LibraryManagement
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-3">
                        <li class="nav-item">
                            <a class="nav-link" href="/Books/Index"><i class="fa-solid fa-book me-1"></i> Books</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Student/Index"><i class="fa-solid fa-user-graduate me-1"></i> Students</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Librarian/Index"><i class="fa-solid fa-user-tie me-1"></i> Librarians</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Dashboard/Index"><i class="fa-solid fa-chart-line me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-outline-light btn-sm mt-1" href="/Login/Index"><i class="fa-solid fa-right-to-bracket me-1"></i> Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <main class="flex-grow-1">
        <div class="container mt-4 mb-5">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto py-4" style="background-color: var(--bg-secondary); border-top: 1px solid var(--border-color);">
        <div class="container text-center">
            <span style="color: var(--text-secondary);">&copy; @DateTime.Now.Year - LibraryManagement. Crafted with <i class="fa-solid fa-heart text-danger"></i>.</span>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
